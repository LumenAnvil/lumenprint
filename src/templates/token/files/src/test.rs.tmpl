#![cfg(test)]
//! Tests run natively against an in-memory host, so `cargo test` needs no
//! network and no deployment.
//!
//! Access control is mocked selectively where it is the thing under test. Using
//! `env.mock_all_auths()` everywhere would make every `require_auth` succeed, so
//! those tests would still pass with the guards deleted.

use super::*;
use soroban_sdk::{
    testutils::{Address as _, MockAuth, MockAuthInvoke},
    Address, Env, IntoVal, String,
};

const DECIMALS: u32 = 7;

/// A deployed token plus the environment and admin behind it.
struct Setup {
    env: Env,
    contract_id: Address,
    client: {% contract_name %}Client<'static>,
    admin: Address,
}

fn setup() -> Setup {
    let env = Env::default();
    let admin = Address::generate(&env);
    let contract_id = env.register(
        {% contract_name %},
        (
            admin.clone(),
            DECIMALS,
            String::from_str(&env, "Example Token"),
            String::from_str(&env, "EXTK"),
        ),
    );
    let client = {% contract_name %}Client::new(&env, &contract_id);

    Setup {
        env,
        contract_id,
        client,
        admin,
    }
}

/// Mint to `to`, authorizing every call. Used to arrange state for tests whose
/// subject is something other than minting.
fn mint(s: &Setup, to: &Address, amount: i128) {
    s.env.mock_all_auths();
    s.client.mint(to, &amount);
}

#[test]
fn constructor_sets_admin_and_metadata() {
    let s = setup();

    assert_eq!(s.client.admin(), s.admin);
    assert_eq!(s.client.decimals(), DECIMALS);
    assert_eq!(s.client.name(), String::from_str(&s.env, "Example Token"));
    assert_eq!(s.client.symbol(), String::from_str(&s.env, "EXTK"));
}

#[test]
fn supply_and_balances_start_at_zero() {
    let s = setup();
    let anyone = Address::generate(&s.env);

    assert_eq!(s.client.total_supply(), 0);
    assert_eq!(s.client.balance(&anyone), 0);
}

#[test]
fn minting_credits_the_holder_and_raises_supply() {
    let s = setup();
    let holder = Address::generate(&s.env);

    mint(&s, &holder, 1_000);

    assert_eq!(s.client.balance(&holder), 1_000);
    assert_eq!(s.client.total_supply(), 1_000);
}

#[test]
fn only_the_admin_may_mint() {
    let s = setup();
    let stranger = Address::generate(&s.env);

    // The stranger authorizes their own call, but minting requires the admin.
    s.env.mock_auths(&[MockAuth {
        address: &stranger,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "mint",
            args: (stranger.clone(), 500i128).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_mint(&stranger, &500).is_err());
    assert_eq!(s.client.total_supply(), 0, "a rejected mint must not create supply");
}

#[test]
fn transfer_moves_balance_between_accounts() {
    let s = setup();
    let alice = Address::generate(&s.env);
    let bob = Address::generate(&s.env);
    mint(&s, &alice, 100);

    s.env.mock_all_auths();
    s.client.transfer(&alice, &bob, &30);

    assert_eq!(s.client.balance(&alice), 70);
    assert_eq!(s.client.balance(&bob), 30);
    assert_eq!(s.client.total_supply(), 100, "transfers must not change supply");
}

#[test]
fn transfer_requires_authorization_from_the_sender() {
    let s = setup();
    let alice = Address::generate(&s.env);
    let bob = Address::generate(&s.env);
    mint(&s, &alice, 100);

    // Bob authorizes a transfer out of Alice's account. The contract requires
    // Alice's authorization, so this must fail.
    s.env.mock_auths(&[MockAuth {
        address: &bob,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "transfer",
            args: (alice.clone(), bob.clone(), 100i128).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_transfer(&alice, &bob, &100).is_err());
    assert_eq!(s.client.balance(&alice), 100, "a rejected transfer must not move value");
    assert_eq!(s.client.balance(&bob), 0);
}

#[test]
fn transfer_beyond_the_balance_is_rejected() {
    let s = setup();
    let alice = Address::generate(&s.env);
    let bob = Address::generate(&s.env);
    mint(&s, &alice, 10);

    s.env.mock_all_auths();

    assert_eq!(
        s.client.try_transfer(&alice, &bob, &11),
        Err(Ok(Error::InsufficientBalance))
    );
    assert_eq!(s.client.balance(&alice), 10);
    assert_eq!(s.client.balance(&bob), 0);
}

#[test]
fn negative_amounts_are_rejected() {
    let s = setup();
    let alice = Address::generate(&s.env);
    let bob = Address::generate(&s.env);
    mint(&s, &alice, 10);

    s.env.mock_all_auths();

    assert_eq!(
        s.client.try_transfer(&alice, &bob, &-1),
        Err(Ok(Error::NegativeAmount))
    );
    assert_eq!(
        s.client.try_mint(&alice, &-1),
        Err(Ok(Error::NegativeAmount))
    );
}

#[test]
fn transferring_to_yourself_is_a_no_op() {
    // Worth pinning down: the debit-then-credit order means a self-transfer must
    // net to zero. Crediting from a stale read would double the balance.
    let s = setup();
    let alice = Address::generate(&s.env);
    mint(&s, &alice, 100);

    s.env.mock_all_auths();
    s.client.transfer(&alice, &alice, &40);

    assert_eq!(s.client.balance(&alice), 100);
    assert_eq!(s.client.total_supply(), 100);
}

#[test]
fn burning_destroys_tokens_and_lowers_supply() {
    let s = setup();
    let alice = Address::generate(&s.env);
    mint(&s, &alice, 100);

    s.env.mock_all_auths();
    s.client.burn(&alice, &40);

    assert_eq!(s.client.balance(&alice), 60);
    assert_eq!(s.client.total_supply(), 60);
}

#[test]
fn the_admin_cannot_burn_someone_elses_tokens() {
    let s = setup();
    let alice = Address::generate(&s.env);
    mint(&s, &alice, 100);

    // Minting is the admin's privilege; destroying a holder's tokens is not.
    s.env.mock_auths(&[MockAuth {
        address: &s.admin,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "burn",
            args: (alice.clone(), 100i128).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_burn(&alice, &100).is_err());
    assert_eq!(s.client.balance(&alice), 100);
}

#[test]
fn burning_more_than_held_is_rejected() {
    let s = setup();
    let alice = Address::generate(&s.env);
    mint(&s, &alice, 10);

    s.env.mock_all_auths();

    assert_eq!(
        s.client.try_burn(&alice, &11),
        Err(Ok(Error::InsufficientBalance))
    );
    assert_eq!(s.client.total_supply(), 10);
}

#[test]
fn supply_accounting_survives_a_sequence_of_operations() {
    let s = setup();
    let alice = Address::generate(&s.env);
    let bob = Address::generate(&s.env);
    s.env.mock_all_auths();

    s.client.mint(&alice, &100);
    s.client.mint(&bob, &50);
    s.client.transfer(&alice, &bob, &25);
    s.client.burn(&bob, &75);

    assert_eq!(s.client.balance(&alice), 75);
    assert_eq!(s.client.balance(&bob), 0);
    assert_eq!(
        s.client.total_supply(),
        75,
        "supply must equal the sum of all balances"
    );
}
