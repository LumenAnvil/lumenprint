[package]
name = "{% project_name %}"
version = "0.1.0"
edition = "{% rust_edition %}"
rust-version = "{% msrv %}"
publish = false

[lib]
# Soroban contracts are built as C-compatible dynamic libraries, which is what
# the wasm target consumes. `cargo test` still works: Cargo builds a separate
# test harness from the same sources.
crate-type = ["cdylib"]
doctest = false

[dependencies]
soroban-sdk = "{% sdk_version %}"

[dev-dependencies]
# `testutils` provides Env::register, Address::generate and the auth mocks used
# in src/test.rs. It must stay a dev-dependency: enabling it in a release build
# bloats the wasm and is rejected on deploy.
soroban-sdk = { version = "{% sdk_version %}", features = ["testutils"] }

# These settings keep the deployed wasm small and its arithmetic checked.
# `overflow-checks` matters more here than anywhere: a silent wrap in a balance
# calculation mints or destroys value. Panicking is the correct outcome.
[profile.release]
opt-level = "z"
overflow-checks = true
debug = 0
strip = "symbols"
debug-assertions = false
panic = "abort"
codegen-units = 1
lto = true
