name: CI

on:
  push:
    branches: [main]
  pull_request:

env:
  CARGO_TERM_COLOR: always
  # Contracts must be built for this target; the older wasm32-unknown-unknown
  # produces a binary the network rejects.
  CONTRACT_TARGET: {% rust_target %}

jobs:
  test:
    name: Build and test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install Rust
        run: |
          rustup toolchain install stable --profile minimal \
            --component rustfmt --component clippy
          rustup target add "$CONTRACT_TARGET"

      - name: Cache cargo
        uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            target
          key: ${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock', '**/Cargo.toml') }}
          restore-keys: ${{ runner.os }}-cargo-

      - name: Format
        run: cargo fmt --all -- --check

      - name: Clippy
        run: cargo clippy --all-targets -- -D warnings

      - name: Test
        run: cargo test --all-features

      - name: Install Stellar CLI
        run: cargo install --locked stellar-cli@{% stellar_cli_version %}

      # The real build. `cargo build` is not a substitute: the Stellar CLI sets
      # the target and post-processes the wasm with contract metadata.
      - name: Build contract
        run: stellar contract build

      - name: Upload wasm
        uses: actions/upload-artifact@v4
        with:
          name: {% project_name %}-wasm
          path: target/{% rust_target %}/release/{% crate_name %}.wasm
          if-no-files-found: error
