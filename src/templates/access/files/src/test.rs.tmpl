#![cfg(test)]
//! Tests run natively against an in-memory host, so `cargo test` needs no
//! network and no deployment.
//!
//! Authorization is the thing worth testing carefully here. The host does not
//! enforce signatures in tests unless you say so, which is what the `mock_auths`
//! family is for:
//!
//! - `env.mock_all_auths()` — every `require_auth` succeeds. Good for testing
//!   behaviour, useless for testing access control.
//! - `env.mock_auths(&[...])` — only the listed authorizations succeed, so a
//!   call that needs a different signer fails. This is how the access-control
//!   tests below prove the guards actually guard.

use super::*;
use soroban_sdk::{
    testutils::{Address as _, MockAuth, MockAuthInvoke},
    Address, Env, IntoVal,
};

/// A registered contract plus the environment and admin it was created with.
struct Setup {
    env: Env,
    contract_id: Address,
    client: {% contract_name %}Client<'static>,
    admin: Address,
}

/// Deploy the contract with a freshly generated admin.
///
/// The trailing tuple is the constructor's arguments, so the admin is set
/// atomically with deployment.
fn setup() -> Setup {
    let env = Env::default();
    let admin = Address::generate(&env);
    let contract_id = env.register({% contract_name %}, (admin.clone(),));
    let client = {% contract_name %}Client::new(&env, &contract_id);

    Setup {
        env,
        contract_id,
        client,
        admin,
    }
}

#[test]
fn constructor_sets_the_admin() {
    let s = setup();

    assert_eq!(s.client.admin(), s.admin);
}

#[test]
fn value_starts_at_zero_and_needs_no_authorization() {
    let s = setup();

    assert_eq!(s.client.value(), 0);
}

#[test]
fn admin_can_set_the_value() {
    let s = setup();
    s.env.mock_all_auths();

    s.client.set_value(&42);

    assert_eq!(s.client.value(), 42);
}

#[test]
fn setting_the_value_requires_authorization_from_the_admin() {
    let s = setup();

    // Authorize the admin for exactly this call, and nothing else.
    s.env.mock_auths(&[MockAuth {
        address: &s.admin,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "set_value",
            args: (7u32,).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_set_value(&7).is_ok());
}

#[test]
fn a_stranger_cannot_set_the_value() {
    let s = setup();
    let stranger = Address::generate(&s.env);

    // The stranger authorizes the call, but the contract requires the admin's
    // authorization, so the host rejects it.
    s.env.mock_auths(&[MockAuth {
        address: &stranger,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "set_value",
            args: (99u32,).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_set_value(&99).is_err());
    assert_eq!(s.client.value(), 0, "a rejected call must not change state");
}

#[test]
fn unauthorized_calls_fail_when_nothing_is_mocked() {
    let s = setup();

    assert!(s.client.try_set_value(&1).is_err());
}

#[test]
fn transfer_admin_moves_control() {
    let s = setup();
    let new_admin = Address::generate(&s.env);
    s.env.mock_all_auths();

    s.client.transfer_admin(&new_admin);

    assert_eq!(s.client.admin(), new_admin);
}

#[test]
fn the_former_admin_loses_access_after_a_transfer() {
    let s = setup();
    let new_admin = Address::generate(&s.env);

    s.env.mock_all_auths();
    s.client.transfer_admin(&new_admin);

    // Re-arm the mocks so only the former admin is authorized; the guard should
    // now demand the new admin instead.
    s.env.mock_auths(&[MockAuth {
        address: &s.admin,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "set_value",
            args: (5u32,).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_set_value(&5).is_err());
}

#[test]
fn the_new_admin_gains_access_after_a_transfer() {
    let s = setup();
    let new_admin = Address::generate(&s.env);

    s.env.mock_all_auths();
    s.client.transfer_admin(&new_admin);

    s.env.mock_auths(&[MockAuth {
        address: &new_admin,
        invoke: &MockAuthInvoke {
            contract: &s.contract_id,
            fn_name: "set_value",
            args: (5u32,).into_val(&s.env),
            sub_invokes: &[],
        },
    }]);

    assert!(s.client.try_set_value(&5).is_ok());
    assert_eq!(s.client.value(), 5);
}
